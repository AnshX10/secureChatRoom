{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "securechatroom.vercel.app" }
      ],
      "destination": "https://ghosttunnel.vercel.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}